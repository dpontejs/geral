{% extends "base.html.j2" %}
{% block title %}Revisão das edições · Geral{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}
{% block content %}
<section class="msg wall">
  <div class="wrap">
    <div class="sheet">
      <h1>Revisão das edições</h1>
      {% if drafts %}
      <p>Cada edição sai sozinha no horário. Segure para pausar (ela espera você soltar) ou tire tópicos; com tópico tirado, a manchete e a abertura são reescritas no envio.</p>
      {% for d in drafts %}
      <article class="review{% if d.held %} held{% endif %}">
        <h2>{{ d.newsletter }} — {{ d.label }}</h2>
        <p>
          {% if d.held %}<b>Segurada</b>: não sai até você soltar.
          {% elif d.late and d.going %}Solta: sai na próxima verificação.
          {% elif d.late %}Não saiu (passou do horário de {{ d.send_at.astimezone(timezone).strftime("%H:%M de %d/%m") }}). Segure e solte para enviar agora.
          {% else %}Sai às {{ d.send_at.astimezone(timezone).strftime("%H:%M de %d/%m") }}.{% endif %}
          · <a href="/revisao/{{ d.id }}/previa?t={{ token }}" target="_blank" rel="noreferrer">Ver a prévia</a>
        </p>
        <form method="post" action="/revisao/{{ d.id }}/{{ 'soltar' if d.held else 'segurar' }}">
          <input type="hidden" name="t" value="{{ token }}">
          <button type="submit">{{ "Soltar edição" if d.held else "Segurar edição" }}</button>
        </form>
        <ol class="topics">
          {% for topic in d.topics %}
          <li{% if topic.removed %} class="removed"{% endif %}>
            {% if topic.removed %}<s>{{ topic.title }}</s> (tirado){% else %}<b>{{ topic.title }}</b>{% endif %}
            <form method="post" action="/revisao/{{ d.id }}/topicos/{{ loop.index0 }}/{{ 'voltar' if topic.removed else 'tirar' }}" style="display:inline">
              <input type="hidden" name="t" value="{{ token }}">
              <button type="submit">{{ "Devolver" if topic.removed else "Tirar" }}</button>
            </form>
          </li>
          {% endfor %}
        </ol>
        {% if d.story %}
        <p><b>História:</b> {{ d.story }}
          <form method="post" action="/revisao/{{ d.id }}/historia/tirar" style="display:inline">
            <input type="hidden" name="t" value="{{ token }}">
            <button type="submit">Tirar (descarta do acervo)</button>
          </form>
        </p>
        {% endif %}
        {% if d.on_this_day %}
        <p><b>Nesta semana:</b> {{ d.on_this_day|join(" · ") }}
          <form method="post" action="/revisao/{{ d.id }}/neste-dia/tirar" style="display:inline">
            <input type="hidden" name="t" value="{{ token }}">
            <button type="submit">Tirar</button>
          </form>
        </p>
        {% endif %}
      </article>
      {% endfor %}
      {% else %}
      <p>Nenhuma edição esperando envio.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
