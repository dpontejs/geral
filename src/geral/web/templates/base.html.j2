<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% block title %}Geral · todas as torcidas numa Geral só{% endblock %}</title>
<meta name="description" content="Newsletters de futebol, uma por torcida: notícias do seu time antes e depois de cada jogo, resumidas por IA, com placar, estatísticas e tabela.">
<meta property="og:title" content="Geral">
<meta property="og:description" content="Todas as torcidas numa Geral só: a newsletter do seu time antes e depois de cada jogo.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ public_url }}/">
<meta property="og:site_name" content="Geral">
<meta property="og:image" content="{{ public_url }}/static/geral/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Geral: o geraldino com o radinho de pilha e o nome do portal">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#EFE4CC">
<link rel="icon" href="/static/geral/icon-512.png">
<link rel="apple-touch-icon" href="/static/geral/icon-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: jornal esportivo dos anos 70 — coluna central de 1080px, faixas de concreto atravessando a página, placar manual escuro como único bloco pesado. Tema único (papel de jornal), escolhido de propósito. */
:root {
  --paper: #EFE4CC;
  --paper-2: #E6D8BA;
  --concrete: #8E8B84;
  --concrete-lt: #B9B5AC;
  --ink: #1E1E1E;
  --ink-soft: #4A4740;
  --ticket: #E3B23C;
  --board: #23221F;
  --vasco: #141414;
  --palmeiras: #006437;
  --abc: #141414;
  --nautico: #C60000;
  --flamengo: #A51C24;
  --display: "Oswald", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  --body: "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  color-scheme: light;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.55 var(--body); }
.wrap { max-width: 1080px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
h1, h2, h3 { font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: .01em; line-height: 1.02; margin: 0; text-wrap: balance; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--ticket); outline-offset: 2px; }
.eyebrow { font: 500 12px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); }

/* cabeçalho */
header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.brand img { width: 56px; height: 56px; }
.brand b { font: 700 40px/1 var(--display); letter-spacing: .02em; }
nav { display: flex; gap: 6px 18px; flex-wrap: wrap; font: 500 15px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; }
nav a { text-decoration: none; padding-block: 6px; border-bottom: 2px solid transparent; }
nav a:hover { border-color: var(--ink); }
.rule { height: 10px; background: repeating-linear-gradient(90deg, var(--concrete) 0 46px, var(--concrete-lt) 46px 50px); }

/* abertura */
.hero .wrap { display: grid; grid-template-columns: 1.15fr .85fr; gap: 40px; padding-block: 44px 52px; align-items: start; }
.hero h1 { font-size: clamp(44px, 7vw, 84px); }
.hero h1 span { background: var(--ticket); padding: 0 .12em; }
.hero p.lead { font-size: 18px; max-width: 34em; margin: 18px 0 0; color: var(--ink-soft); }
.hero .stats { display: flex; gap: 28px; margin-top: 26px; flex-wrap: wrap; }
.hero .stats div { font: 700 30px/1 var(--display); font-variant-numeric: tabular-nums; }
.hero .stats small { display: block; font: 500 11px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); margin-top: 4px; }

/* ingresso de inscrição */
.ticket { background: var(--paper-2); border: 2px solid var(--ink); position: relative; padding: 22px 22px 20px; }
.ticket::before, .ticket::after { content: ""; position: absolute; top: 50%; width: 22px; height: 22px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); transform: translateY(-50%); }
.ticket::before { left: -13px; clip-path: inset(0 0 0 50%); }
.ticket::after { right: -13px; clip-path: inset(0 50% 0 0); }
.ticket .top { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--concrete); padding-bottom: 10px; margin-bottom: 14px; }
.ticket .top h2 { font-size: 26px; }
.ticket .top span { font: 500 12px/1 var(--mono); color: var(--ink-soft); }
.ticket label.field { display: block; font: 500 12px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 6px; }
.ticket input[type=email] { width: 100%; font: 16px var(--body); padding: 11px 12px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); }
.picks { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 16px 0; }
.pick { display: flex; align-items: center; gap: 8px; border: 2px solid var(--ink); padding: 6px 8px; cursor: pointer; background: var(--paper); font: 500 14px/1.2 var(--display); text-transform: uppercase; letter-spacing: .03em; }
.pick img { width: 30px; height: 30px; flex: none; }
.pick input { position: absolute; opacity: 0; pointer-events: none; }
.pick:has(input:checked) { background: var(--c); color: #fff; border-color: var(--c); }
.pick:has(input:focus-visible) { outline: 3px solid var(--ticket); outline-offset: 2px; }
.pick.geral-pick { --c: var(--ink); }
.btn { display: inline-block; font: 700 18px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; background: var(--ink); color: var(--paper); border: 0; padding: 14px 20px; cursor: pointer; width: 100%; }
.btn:hover { background: #000; }
.ticket .fine { font-size: 12.5px; color: var(--ink-soft); margin: 10px 0 0; }
.ticket .ok { font: 500 15px/1.5 var(--body); }
.ticket .ok strong { font-family: var(--display); font-size: 22px; text-transform: uppercase; display: block; margin-bottom: 6px; }

/* torcidas */
section.block .wrap { padding-block: 48px; }
.head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
.head h2 { font-size: clamp(30px, 4.5vw, 46px); }
.head p { margin: 0; color: var(--ink-soft); max-width: 30em; }
.torcidas { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.torcida { background: var(--paper-2); border-top: 8px solid var(--c); display: flex; flex-direction: column; min-width: 0; }
.torcida .face { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 16px 10px; }
.torcida .face img { width: 72px; height: 72px; flex: none; }
.torcida h3 { font-size: 22px; color: var(--c); }
.torcida .tag { display: inline-block; font: 500 10.5px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; background: var(--c); color: #fff; padding: 4px 6px; margin-top: 6px; }
.torcida .club { font: 500 12px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
.torcida .last { padding: 0 16px 14px; flex: 1; }
.torcida .last .eyebrow { display: block; margin-bottom: 6px; }
.torcida .last p { margin: 0; font-weight: 600; line-height: 1.35; }
.torcida .foot { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-top: 2px dashed var(--concrete-lt); font: 500 13px/1 var(--mono); }
.torcida .foot a { font-family: var(--display); text-transform: uppercase; letter-spacing: .05em; text-decoration: none; border-bottom: 2px solid var(--c); padding-bottom: 2px; }

/* enquanto seu time não chega */
.waiting { background: var(--concrete-lt); }
.wait-grid { display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; gap: 18px; }
.card { background: var(--paper); padding: 18px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.card h3 { font-size: 22px; }
.card p { margin: 0; color: var(--ink-soft); font-size: 15px; }
.card .go { margin-top: auto; font: 500 15px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; }
.request { background: var(--ink); color: var(--paper); }
.request p { color: var(--concrete-lt); }
.request form { display: flex; gap: 8px; flex-wrap: wrap; }
.request input { flex: 1 1 140px; min-width: 0; font: 15px var(--body); padding: 10px; border: 2px solid var(--paper); background: transparent; color: var(--paper); }
.request input::placeholder { color: var(--concrete-lt); }
.request button { font: 700 15px/1 var(--display); text-transform: uppercase; letter-spacing: .05em; background: var(--ticket); color: var(--ink); border: 0; padding: 10px 14px; cursor: pointer; }
.queue { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 6px; }
.queue li { display: flex; justify-content: space-between; gap: 8px; font: 500 14px/1.2 var(--mono); }
.queue .bar { flex: 1; align-self: center; height: 6px; background: #3A3833; position: relative; }
.queue .bar i { position: absolute; inset: 0 auto 0 0; background: var(--ticket); }
.series { display: flex; gap: 6px; flex-wrap: wrap; }
.series span { font: 700 13px/1 var(--display); border: 2px solid var(--ink); padding: 5px 8px; letter-spacing: .05em; }
.quiz { font: 700 44px/1 var(--display); letter-spacing: .02em; }

/* placar */
.placar-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 32px; align-items: center; }
.placar { background: var(--board); color: #F2EEE4; padding: 18px; border: 6px solid var(--concrete); overflow-x: auto; }
.placar table { width: 100%; border-collapse: separate; border-spacing: 0 6px; min-width: 340px; }
.placar th { font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--concrete-lt); text-align: left; padding: 0 8px 4px; }
.placar td { font: 700 22px/1 var(--display); text-transform: uppercase; letter-spacing: .04em; padding: 6px 8px; background: #2E2D29; }
.placar td.n { text-align: right; font-variant-numeric: tabular-nums; color: var(--ticket); width: 1%; white-space: nowrap; }
.placar td.pos { width: 1%; color: var(--concrete-lt); }
.placar td .dot { display: inline-block; width: 12px; height: 12px; background: var(--c); border: 2px solid #F2EEE4; margin-right: 10px; vertical-align: 1px; }
.placar caption { caption-side: bottom; text-align: left; font: 500 11px/1.4 var(--mono); color: var(--concrete-lt); padding-top: 8px; }
.note { font-size: 15px; color: var(--ink-soft); }
.note b { color: var(--ink); }

footer { border-top: 2px solid var(--ink); }
footer .wrap { padding-block: 24px 32px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13.5px; color: var(--ink-soft); }

@media (max-width: 900px) {
  .hero .wrap, .placar-wrap { grid-template-columns: 1fr; }
  .torcidas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .torcidas .torcida:first-child { grid-column: 1 / -1; }
  .wait-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .torcidas, .wait-grid { grid-template-columns: 1fr; }
  .brand b { font-size: 32px; }
}
@media (prefers-reduced-motion: no-preference) {
  .placar td.n { transition: color .3s; }
}

/* páginas de mensagem e da torcida */
.msg .wrap { padding-block: 56px 72px; max-width: 720px; }
.msg h1 { font-size: clamp(36px, 6vw, 56px); }
.msg p { font-size: 18px; color: var(--ink-soft); margin: 16px 0 24px; }
.msg form { display: flex; gap: 10px; flex-wrap: wrap; }
.msg .btn { width: auto; }
.btn.secondary { background: transparent; color: var(--ink); border: 2px solid var(--ink); }
.error { background: var(--ink); color: var(--paper); padding: 10px 12px; margin: 0 0 12px; font-weight: 600; }
.soon { opacity: .75; }
.soon .go { color: var(--ink-soft); }
.edition-frame { background: #fff; border: 2px solid var(--ink); }
.hidden-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Geral, início"><img src="/static/geral/icon-512.png" alt=""><b>GERAL</b></a>
    <nav aria-label="Seções">
      <a href="/#torcidas">Torcidas</a>
      <a href="/#enquanto">Edição geral</a>
      <a href="/#placar">Placar</a>
      <a href="/#enquanto">Joguinhos</a>
      <a href="/#enquanto">Peça seu time</a>
    </nav>
  </div>
  <div class="rule" aria-hidden="true"></div>
</header>
<main id="inicio">
{% block content %}{% endblock %}
</main>
<footer>
  <div class="wrap">
    <span>Geral · feita por torcedores, sem ligação oficial com os clubes.</span>
    <span>Guardamos só o seu e-mail e as torcidas que você escolheu. Resumos gerados com IA; dados: ESPN e ge.</span>
  </div>
</footer>
</body>
</html>
