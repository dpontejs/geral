<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% block title %}Geral · todas as torcidas numa Geral só{% endblock %}</title>
<meta name="description" content="Newsletters de futebol, uma por torcida: notícias do seu time antes e depois de cada jogo, resumidas por IA, com placar, estatísticas e tabela.">
<meta property="og:title" content="Geral">
<meta property="og:description" content="Todas as torcidas numa Geral só: a newsletter do seu time antes e depois de cada jogo.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ public_url }}/">
<meta property="og:site_name" content="Geral">
<meta property="og:image" content="{{ public_url }}/static/geral/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Geral: o geraldino com o radinho de pilha e o nome do portal">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0E3320">
<link rel="icon" href="/static/geral/icon-512.png">
<link rel="apple-touch-icon" href="/static/geral/icon-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Big+Shoulders+Stencil+Display:wght@800&family=Doto:wght@900&family=Barlow:wght@400;500;600;700&display=swap">
<style>
/* A Geral do Maracanã antigo: o gramado colado na Geral, ingresso de papel e o placar
   eletrônico de lâmpadas amarelas. O placar aparece só no topo e nos joguinhos; o resto é
   gramado e papel. As cores dos clubes ficam fora do painel (o placar antigo era de uma cor
   só). Tema único. */
:root {
  --paper: #EFE4CC;
  --paper-2: #E6D8BA;
  --concrete-lt: #B9B5AC;
  --ink: #14231A;
  --ink-soft: #3F3C36;
  --ticket: #E3B23C;
  --board: #0B0B0A;
  --lamp: #FFC21A;
  --lamp-off: #1D1C18;
  --turf: #0E3320;
  --pitch: #1F7A3D;
  --pitch-2: #248A46;
  --chalk: rgba(255, 255, 255, .7);
  --on-pitch: #F1F5EC;
  /* small light text on the striped grass: a dark halo keeps it readable on the lighter stripe */
  --on-grass: 0 1px 2px var(--turf), 0 0 6px rgba(14, 51, 32, .6);
  --wash: #D3E2C6; /* the field away from the stands: plain grass, marked in white */
  --display: "Big Shoulders Display", "Arial Narrow", Impact, sans-serif;
  --stencil: "Big Shoulders Stencil Display", "Big Shoulders Display", Impact, sans-serif;
  --dots: "Doto", ui-monospace, monospace;
  --body: "Barlow", "Helvetica Neue", Arial, sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
/* Below a short page's footer, the footer's colour carries on instead of more grass. */
html { background: var(--turf); }
body { margin: 0; background: var(--wash); color: var(--ink); font: 17px/1.5 var(--body); }
.wrap { max-width: 1180px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
h1, h2, h3 { font-family: var(--display); font-weight: 900; text-transform: uppercase; line-height: .92; margin: 0; text-wrap: balance; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--ticket); outline-offset: 2px; }

/* painel de lâmpadas */
.board { background-color: var(--board); background-image: radial-gradient(circle, var(--lamp-off) 1.6px, transparent 2.1px); background-size: 7px 7px; color: var(--lamp); }
.lamp, .clock, .ranking .name, .ranking .n { font-family: var(--dots); font-weight: 900; text-transform: uppercase; color: var(--lamp); letter-spacing: .1em; line-height: 1; text-shadow: 0 0 6px rgba(255, 194, 26, .55), 0 0 18px rgba(255, 170, 0, .25); }
@media (prefers-reduced-motion: no-preference) {
  .blink { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: .1; } }
}

/* cabeçalho */
header { background: var(--turf); color: var(--paper); }
header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.brand img { width: 48px; height: 48px; }
.brand b { font: 800 38px/1 var(--stencil); letter-spacing: .04em; }
nav { display: flex; flex-wrap: wrap; gap: 4px; font: 800 17px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; }
nav a { text-decoration: none; padding: 13px 12px; }
nav a:hover { color: var(--lamp); }
nav a.cta { background: var(--ticket); color: var(--ink); }
nav a.cta:hover { background: var(--lamp); color: var(--ink); }

/* gramado cortado em faixas, com as linhas de cal */
.wall { position: relative; overflow: hidden; background-color: var(--pitch); background-image: repeating-linear-gradient(90deg, var(--pitch) 0 90px, var(--pitch-2) 90px 180px); }
.wall::before { content: ""; position: absolute; right: -160px; top: -160px; width: 420px; height: 420px; border: 5px solid var(--chalk); border-radius: 50%; pointer-events: none; }
.wall::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; border-top: 5px solid #fff; pointer-events: none; } /* the goal line: the penalty area below hangs from it */
.wall > .wrap { position: relative; }
.hero .wrap { display: flex; flex-direction: column; gap: 24px; padding-block: 40px 48px; }
.hero h1 { font-size: clamp(52px, 9vw, 124px); color: #fff; text-shadow: 5px 5px 0 var(--turf); }
.hero .lead { margin: 0; max-width: none; font-size: 19px; background: var(--paper); padding: 14px 18px; border: 3px solid var(--turf); }
.scoreboard { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .5fr) minmax(0, 1.4fr); border: 10px solid var(--turf); box-shadow: inset 0 0 0 3px #000, 6px 6px 0 rgba(0, 0, 0, .35); }
.scoreboard > div { min-width: 0; border-right: 6px solid #000; }
.scoreboard > div:last-child { border-right: 0; }
.scoreboard .play { display: flex; align-items: center; padding: 16px; }
.lance { display: block; width: 100%; height: auto; }
.scoreboard .clockbox { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; padding: 16px 8px; text-align: center; }
.clock { font-size: clamp(28px, 3.4vw, 54px); letter-spacing: .02em; white-space: nowrap; }
.clockbox .total { font-size: clamp(28px, 3vw, 40px); }
.clockbox small { font-size: 13px; letter-spacing: .14em; }
.ranking { list-style: none; margin: 0; padding: 14px 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; height: 100%; }
.ranking li { display: grid; grid-template-columns: 14px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 7px 22px; }
.ranking .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 2px var(--paper); }
/* Portal board: names and counts only, in lamp yellow like the rest of the board. */
.ranking.lamps li { grid-template-columns: minmax(0, 1fr) auto; }
/* The font's colon looked like a "+": two lamps drawn instead. */
.clock .colon { display: inline-block; width: .32em; height: .62em; margin: 0 .06em; vertical-align: .08em; background: radial-gradient(circle at 50% 15%, var(--lamp) 0 .07em, transparent .085em), radial-gradient(circle at 50% 85%, var(--lamp) 0 .07em, transparent .085em); filter: drop-shadow(0 0 4px rgba(255, 194, 26, .6)); }
.ranking .name, .ranking .n { font-size: clamp(26px, 3.4vw, 46px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ranking .n { font-variant-numeric: tabular-nums; }

/* ingresso de inscrição */
/* the ticket stands in the penalty area; the halfway line leads to the teams */
.signup .wrap { padding-block: 0; }
.area { position: relative; border: 5px solid #fff; border-top: 0; padding: 40px 36px 44px; }
.arc { position: absolute; left: 50%; bottom: -62px; width: 160px; height: 60px; margin-left: -80px; border: 5px solid #fff; border-top: 0; border-radius: 0 0 80px 80px; }
.halfway { position: relative; border-top: 5px solid #fff; margin: 110px 0 56px; }
.halfway::after { content: ""; position: absolute; left: 50%; top: -12px; width: 20px; height: 20px; margin-left: -10px; border-radius: 50%; background: #fff; }
.ticket { background: var(--paper); display: flex; flex-wrap: wrap; border: 3px solid var(--ink); }
.ticket .stub { flex: 0 0 210px; border-right: 3px dashed var(--ink); padding: 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; background: var(--ticket); }
.ticket .stub h2 { font-size: 40px; }
.ticket .stub span { font-weight: 600; font-size: 15px; line-height: 1.3; }
.ticket .stub .serial { font: 800 24px/1 var(--stencil); letter-spacing: .1em; }
.ticket .body { flex: 1 1 420px; padding: 22px 26px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.ticket .body h3 { font-size: 40px; }
.picks { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
.pick { position: relative; display: inline-flex; align-items: center; gap: 8px; border: 3px solid var(--ink); padding: 5px 14px 5px 5px; cursor: pointer; background: var(--paper); font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; min-height: 46px; }
.pick img { width: 32px; height: 32px; flex: none; }
.pick input { position: absolute; opacity: 0; pointer-events: none; }
.pick:has(input:checked) { background: var(--c); color: #fff; border-color: var(--c); }
.pick:has(input:focus-visible) { outline: 3px solid var(--ticket); outline-offset: 2px; }
.ticket .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
.ticket label.field { flex: 1 1 260px; display: flex; flex-direction: column; gap: 6px; font-weight: 600; }
.ticket input[type=email], .ticket input[type=text] { font: 17px var(--body); padding: 12px; border: 3px solid var(--ink); background: #fff; color: var(--ink); width: 100%; }
.btn { display: inline-block; font: 900 24px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; background: var(--turf); color: var(--paper); border: 0; padding: 15px 26px; min-height: 52px; cursor: pointer; text-decoration: none; }
.btn:hover { background: #000; color: var(--lamp); }
.ticket .fine { font-size: 14px; color: var(--ink-soft); margin: 0; }

/* torcidas */
section.block .wrap { padding-block: 8px 52px; }
.block h2 { font-size: clamp(40px, 5vw, 64px); }
.block .head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.block .head p { margin: 0; color: var(--ink-soft); max-width: 30em; }
.torcidas { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
.torcida { background: var(--paper); border-top: 10px solid var(--c); display: flex; flex-direction: column; gap: 10px; padding: 18px; min-width: 0; }
.torcida img { width: 84px; height: 84px; }
.torcida h3 { font-size: 32px; }
.torcida .club { font-weight: 600; font-size: 14px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .06em; }
.torcida .last { flex: 1; margin: 0; font-size: 16px; }
.torcida .last b { display: block; font: 800 15px/1.2 var(--display); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft); }
.torcida .foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-top: 2px dashed #9AA88F; padding-top: 10px; font-weight: 600; font-size: 15px; }
.torcida .foot a { font: 800 18px/1 var(--display); text-transform: uppercase; letter-spacing: .05em; text-decoration: none; border-bottom: 3px solid var(--c); padding: 8px 0 3px; }

.pedir-strip { margin-top: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; padding: 18px 22px; background: var(--paper); color: var(--ink); border: 3px dashed var(--turf); text-decoration: none; }
.pedir-strip > b { font: 900 26px/1 var(--display); text-transform: uppercase; }
.pedir-strip span { flex: 1 1 320px; }
.pedir-strip .go { flex: 0 0 auto; font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; color: var(--turf); }
.pedir-strip:hover { border-style: solid; border-color: var(--ticket); }

/* por que Geral */
.why { background: var(--turf); color: var(--on-pitch); border-block: 5px solid var(--chalk); }
.why .wrap { display: flex; flex-wrap: wrap; gap: 36px; align-items: center; padding-block: 52px; }
.why img { width: 240px; height: 240px; flex: none; }
.why .text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
.why h2 { font-size: clamp(40px, 5vw, 64px); color: #fff; }
.why p { margin: 0; font-size: 18px; max-width: 60ch; }

/* intervalo: joguinhos e pedidos */
.intervalo.wall .wrap { padding-bottom: 64px; }
.intervalo.wall::before { display: none; } /* the circle would cross the intro text */
.intervalo.wall h2 { color: #fff; text-shadow: 4px 4px 0 var(--turf); }
.intervalo.wall .head p { color: var(--on-pitch); text-shadow: var(--on-grass); }
.intervalo .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); grid-auto-rows: 1fr; gap: 14px; }
.mini { padding: 20px; display: flex; flex-direction: column; gap: 12px; color: #D9D4C8; border: 8px solid var(--turf); min-width: 0; }
.mini .lamp.tag { font-size: 15px; opacity: .75; }
.mini .lamp.title { font-size: 30px; line-height: 1.1; }
.mini p { margin: 0; font-size: 15px; flex: 1; }
.play-card { text-decoration: none; }
.play-card:hover { border-color: var(--ticket); }
.intervalo .head .more { color: var(--lamp); font-weight: 700; white-space: nowrap; }
.mini .go.soon { color: #8F978A; }
.mini .go { margin-top: auto; font: 800 20px/1 var(--display); text-transform: uppercase; letter-spacing: .06em; color: var(--lamp); }

footer { background: var(--turf); color: #C9D6C2; }
footer .wrap { padding-block: 22px 30px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px; }

@media (max-width: 900px) {
  .scoreboard { grid-template-columns: 1fr; }
  .scoreboard > div { border-right: 0; border-bottom: 6px solid #000; }
  .scoreboard > div:last-child { border-bottom: 0; }
  .scoreboard .clockbox { flex-direction: row; flex-wrap: wrap; gap: 16px; }
}
@media (max-width: 640px) {
  .picks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pick { font-size: 16px; padding-right: 8px; }
  .area { padding: 20px 12px 32px; }
  .halfway { margin: 96px 0 40px; }
  .wall::before { right: -110px; top: -110px; width: 200px; height: 200px; }
  .ticket .stub { flex-basis: 100%; border-right: 0; border-bottom: 3px dashed var(--ink); }
  .ranking li { gap: 10px; padding: 6px 14px; }
  .why img { width: 140px; height: 140px; }
  .brand b { font-size: 32px; }
}

/* página da edição */
.edition-head .wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding-block: 28px 44px; }
.edition-head h1 { font-size: clamp(44px, 7vw, 88px); color: #fff; text-shadow: 5px 5px 0 var(--turf); }
.edition-head .lead { margin: 0; align-self: stretch; max-width: none; font-size: 18px; background: var(--paper); padding: 12px 16px; border: 3px solid var(--turf); }
.edition-head .btn { background: var(--ticket); color: var(--ink); }
.back { font: 800 17px/1 var(--display); text-transform: uppercase; letter-spacing: .05em; color: #fff; text-decoration: none; padding: 10px 0; text-shadow: var(--on-grass); }
.back:hover { color: var(--lamp); }
.edition-body .wrap { padding-block: 32px 56px; }
.edition-frame { display: block; width: 100%; max-width: 680px; height: 1400px; margin: 0 auto; border: 3px solid var(--ink); background: #fff; box-shadow: 6px 6px 0 rgba(0, 0, 0, .2); }

/* páginas de mensagem */
.msg .wrap { padding-block: 56px 72px; max-width: 760px; }
.msg .sheet { background: var(--paper); border: 3px solid var(--ink); padding: 28px; }
.msg h1 { font-size: clamp(40px, 6vw, 64px); }
.msg p { font-size: 18px; color: var(--ink-soft); margin: 16px 0 24px; }
.msg form { display: flex; gap: 10px; flex-wrap: wrap; }
.btn.secondary { background: transparent; color: var(--ink); border: 3px solid var(--ink); }
.btn.secondary:hover { background: var(--ink); color: var(--paper); }
.error { background: var(--ink); color: var(--paper); padding: 10px 12px; margin: 0; font-weight: 600; }
.bolao-board { padding: 16px; border: 10px solid var(--turf); max-width: 560px; }
.ranking li.me { outline: 3px solid var(--lamp); outline-offset: 2px; }
.score-inputs { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font: 700 22px/1 var(--display); text-transform: uppercase; }
.score-inputs input, input.nick { font: 16px var(--body); padding: 10px; border: 3px solid var(--ink); background: var(--paper); color: var(--ink); width: 5em; }
input.nick { width: min(100%, 320px); display: block; }
.hidden-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
{% block head %}{% endblock %}
</head>
<body>
<header>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Geral, início"><img src="/static/geral/icon-512.png" alt=""><b>GERAL</b></a>
    <nav aria-label="Seções">
      {% if request.url.path != "/" %}<a href="/">Início</a>{% endif %}
      <a href="/#torcidas">Torcidas</a>
      <a href="/#placar">Placar</a>
      <a href="/jogos">Joguinhos</a>
      <a href="/pedir">Peça seu time</a>
      <a class="cta" href="/#signup">Entrar na Geral</a>
    </nav>
  </div>
</header>
<main id="inicio">
{% block content %}{% endblock %}
</main>
<footer>
  <div class="wrap">
    <span>Geral · feita por torcedores, sem ligação oficial com os clubes.</span>
    <span>Guardamos só o seu e-mail e as torcidas que você escolheu. Resumos gerados com IA; dados: ESPN e ge.</span>
  </div>
</footer>
</body>
</html>
