{% extends "base.html.j2" %}
{% set label = team.name if team else "Geral" %}
{% block title %}Carreira · {{ label }} · Geral{% endblock %}
{% block head %}<link rel="stylesheet" href="/static/geral/jogos.css?v={{ asset_version }}">{% endblock %}
{% block content %}
<section class="jogo wall">
  <div class="wrap" id="cr" data-edition="{{ edition }}">
    {% include "_game_tabs.html.j2" %}
    <div class="game-title"><h1>Carreira</h1><button type="button" class="rules-open" aria-label="Como jogar">?</button></div>

    <div class="stage">

      {% if compartilhada %}
      {# A shared career: the card, and the whole career when the data still replays it. #}
      {% set r = compartilhada.resumo %}
      <div class="result cr-shared">
        <span class="cr-kicker">A carreira de {{ r.nome }} · {{ r.posicao }}</span>
        <h2>{{ r.rotulo }}</h2>
        <span class="final">Nota {{ r.nota }} · 🏆 {{ r.titulos }}</span>
        <p class="cr-clubs">{{ r.clubes | join(" → ") }}</p>
        <div class="actions"><a class="btn" href="/jogos/carreira{% if edition != 'geral' %}/{{ edition }}{% endif %}">Jogar a sua</a></div>
      </div>
      {% endif %}

      {# 1. The player. #}
      <form class="board match cr-step" id="cr-craque"{% if compartilhada %} hidden{% endif %}>
        <span class="lamp meta">Monte seu craque</span>
        <div class="cr-fields">
          <label class="cr-field cr-name"><span>Nome</span><input id="cr-nome" name="nome" maxlength="24" required autocomplete="off" spellcheck="false" placeholder="Como a torcida vai chamar"></label>
          <label class="cr-field cr-number"><span>Camisa</span><input id="cr-camisa" name="camisa" type="number" min="1" max="99" value="10" required inputmode="numeric"></label>
        </div>
        <fieldset class="cr-choice"><legend>Posição</legend>
          {% for p in jogo.posicoes %}<button type="button" class="chip" data-posicao="{{ p }}" aria-pressed="{{ 'true' if p == 'atacante' else 'false' }}">{{ p }}</button>{% endfor %}
        </fieldset>
        <fieldset class="cr-choice"><legend>Pé bom</legend>
          {% for p, nome in [("direito", "Direito"), ("esquerdo", "Esquerdo"), ("ambos", "Os dois")] %}<button type="button" class="chip" data-pe="{{ p }}" aria-pressed="{{ 'true' if p == 'direito' else 'false' }}">{{ nome }}</button>{% endfor %}
        </fieldset>
        <label class="cr-field"><span>Começa na base do</span>
          <select id="cr-clube" required>{% for c in jogo.clubes %}<option value="{{ c.id }}"{% if c.id == "abc" %} selected{% endif %}>{{ c.nome }}</option>{% endfor %}</select>
        </label>
        <fieldset class="cr-minis"><legend>Lances decisivos</legend>
          <button type="button" class="cr-mini" data-minijogos="true" aria-pressed="true"><b>Com minijogos</b><span>Numa final de copa, você bate o pênalti decisivo.</span></button>
          <button type="button" class="cr-mini" data-minijogos="false" aria-pressed="false"><b>Sem minijogos</b><span>O motor bate por você, pela finalização do craque.</span></button>
        </fieldset>
        <button class="btn cr-go" type="submit">Começar o draft</button>
      </form>

      {# 2. The draft: one attribute from each legend. #}
      <div class="cr-step cr-draft" id="cr-draft" hidden>
        <div class="board match cr-placar">
          <div class="cr-placar-top"><span class="lamp meta" id="cr-quem"></span><span class="lamp cr-overall"><small>geral</small> <b id="cr-overall">–</b></span></div>
          <ol class="cr-attrs" id="cr-attrs"></ol>
        </div>
        <div class="cr-legend" id="cr-legend">
          <div class="cr-legend-top"><span class="cr-count" id="cr-count"></span><button class="btn secondary cr-reroll" type="button" id="cr-reroll">Sortear outro (2)</button></div>
          <h2 id="cr-legend-name"></h2>
          <span class="cr-legend-tag" id="cr-legend-tag" hidden>Ídolo do Nordeste</span>
          <p class="cr-hint">Roube um atributo:</p>
          <div class="cr-steal" id="cr-steal"></div>
        </div>
      </div>

      {# 3. The career: the season just played as a newspaper clipping, the earlier ones below. #}
      <div class="cr-step" id="cr-carreira" hidden>
        <div class="board cr-bar" id="cr-bar"><span class="lamp" id="cr-bar-who"></span><span class="lamp" id="cr-bar-nota"></span></div>
        <article class="cr-now" id="cr-now" aria-live="polite"></article>
        <section class="cr-penalti" id="cr-penalti" hidden></section>
        <section class="cr-question" id="cr-question" hidden>
          <span class="cr-q-kind" id="cr-q-kind"></span>
          <p class="cr-q-text" id="cr-question-text"></p>
          <div class="cr-options" id="cr-options"></div>
        </section>
        <p class="how" id="cr-error" role="alert" hidden></p>
        <div class="cr-controls">
          <button class="btn cr-next" type="button" id="cr-next" hidden>Próxima temporada →</button>
          <button class="btn" type="button" id="cr-retry" hidden>Tentar de novo</button>
        </div>
        <section class="cr-cabinet" id="cr-cabinet" hidden><h3>Sala de troféus</h3><ul class="cr-shelf" id="cr-shelf"></ul></section>
        <details class="cr-history" id="cr-history" open><summary>Linha do tempo</summary><ol class="cr-timeline" id="cr-timeline"></ol></details>
      </div>
    </div>

    {# 4. The end: the card to share. #}
    <div class="result cr-end" id="cr-end" hidden>
      <img class="cr-card" id="cr-card" alt="A capa da carreira">
      <div class="cr-end-info">
        <span class="cr-kicker" id="cr-end-kicker"></span>
        <h2 id="cr-end-label"></h2>
        <p class="cr-end-desc" id="cr-end-desc"></p>
        <ul class="cr-end-marks" id="cr-end-marks" hidden></ul>
        <p class="cr-end-placar" id="cr-end-placar" hidden></p>
        <dl class="cr-end-stats" id="cr-end-stats"></dl>
        <section class="cr-verdicts" id="cr-end-vereditos" hidden><h3>O que dizem as torcidas</h3><ul id="cr-verdict-list"></ul></section>
        <section class="cr-cabinet" id="cr-end-cabinet" hidden><h3>Sala de troféus</h3><ul class="cr-shelf" id="cr-end-shelf"></ul></section>
        <div class="cr-end-actions">
          <button class="btn" type="button" id="cr-share">Compartilhar</button>
          <a class="btn secondary" id="cr-download" download="carreira.png">Baixar a capa</a>
          <button class="btn secondary" type="button" id="cr-again">Jogar de novo</button>
          <span class="cr-copied" id="cr-copied" role="status"></span>
        </div>
      </div>
    </div>

    <section class="cr-fabrica" id="cr-fabrica">
      <h2>Fábrica de craques</h2>
      <p class="cr-fabrica-lead">Toda carreira terminada conta para o clube onde o craque começou. Jogue pelo seu e ajude a subir.</p>
      <ol class="cr-fabrica-list" id="cr-fabrica-list"></ol>
    </section>

    <script type="application/json" id="cr-data">{{ jogo | tojson }}</script>
    <p class="credit">As notas das lendas são da redação da Geral: discorda? Responda qualquer newsletter.</p>
    {% set rules_key = "carreira" %}{% set rules %}Dê nome, camisa, posição e pé ao seu craque.|No draft passam 8 nomes, entre lendas e jogadores de verdade: de cada um você rouba um atributo. Escolha bem, porque cada atributo só pode ser roubado uma vez. Você pode trocar o nome da vez duas vezes.|Depois é com ele: a carreira acontece temporada a temporada, dos 16 anos até a aposentadoria, e de vez em quando você decide o rumo. Com minijogos, se o time chegar a uma final de copa, você bate o pênalti decisivo.|No fim, um card com a nota, os títulos e o jogador real com quem sua carreira mais se parece. Jogue quantas vezes quiser.{% endset %}{% set rules = rules.split("|") %}{% include "_regras.html.j2" %}
  </div>
</section>
<script src="/static/geral/penalti.js?v={{ asset_version }}" defer></script>
<script src="/static/geral/carreira.js?v={{ asset_version }}" defer></script>
{% endblock %}
