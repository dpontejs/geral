<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Geral — {{ e.label }}</title>
{# The marked field (docs/features/identidade-geral.md): striped grass on top, plain lighter grass
   in the middle with the halfway line between séries, results on the board in lamp yellow.
   Only e-mail-safe fonts: Impact stands in for the portal's condensed display face, and
   Android (no Impact) gets its own condensed Roboto. #}
<style>
  body { margin: 0; padding: 0; background-color: {{ wash }}; color: {{ ink }}; }
  .font { font-family: Arial, Helvetica, sans-serif; }
  .display { font-family: Impact, "sans-serif-condensed", "Roboto Condensed", "Arial Narrow", sans-serif; font-weight: normal; text-transform: uppercase; }
  .mono { font-family: "Courier New", Courier, monospace; font-weight: bold; }
  .wrap { max-width: 600px; }
  .hero { background-color: {{ pitch }}; padding: 18px 16px 22px 16px; }
  .seal { background-color: {{ paper }}; border: 3px solid {{ turf }}; padding: 4px 8px; }
  .seal-text { font-size: 30px; letter-spacing: 3px; color: {{ ink }}; line-height: 1; }
  .kicker { display: inline-block; background-color: {{ ticket }}; color: {{ ink }}; font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; padding: 3px 8px; }
  .headline { font-size: 34px; line-height: 1.05; color: #FFFFFF; margin: 10px 0 12px 0; text-shadow: 3px 3px 0 {{ turf }}; }
  .intro { background-color: {{ paper }}; border: 3px solid {{ turf }}; padding: 10px 12px; font-size: 16px; line-height: 1.5; color: {{ ink }}; }
  .halfway { padding: 6px 0; }
  .chalk { border-top: 3px solid #FFFFFF; font-size: 0; line-height: 0; height: 0; }
  .serie { background-color: #FFFFFF; border: 3px solid {{ turf }}; }
  .serie-name { background-color: {{ turf }}; color: {{ paper }}; font-size: 22px; letter-spacing: 1px; padding: 7px 12px; }
  .serie-phase { background-color: {{ turf }}; padding: 7px 12px; }
  .phase { background-color: {{ ticket }}; color: {{ ink }}; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 3px 7px; }
  .serie-body { padding: 14px; }
  .summary { font-size: 15px; line-height: 1.5; margin: 0 0 12px 0; }
  .label { font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: {{ pitch }}; margin: 14px 0 6px 0; }
  .game { background-color: {{ board }}; }
  .team { color: #FFFFFF; font-size: 14px; font-weight: bold; padding: 7px 8px; }
  .score { color: {{ lamp }}; font-size: 16px; white-space: nowrap; padding: 7px 4px; }
  .pens { font-size: 11px; color: {{ ticket }}; font-weight: normal; }
  .table td { font-size: 13px; padding: 4px 2px; border-bottom: 1px solid #E6ECE0; }
  .gap td { font-size: 12px; color: {{ concrete }}; text-align: center; }
  .news { margin: 0 0 8px 0; font-size: 14px; line-height: 1.4; }
  .news a { color: {{ ink }}; font-weight: 700; }
  .foot { background-color: {{ turf }}; color: #CFD8CC; font-size: 12px; line-height: 1.5; padding: 18px 16px; }
  .foot a { color: {{ paper }}; }
</style>
</head>
<body>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: {{ wash }};"><tr><td align="center" style="padding: 0;">
<table role="presentation" class="wrap font" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td class="hero"{% if static %} background="{{ static }}/campo-topo.png" style="background-image: url('{{ static }}/campo-topo.png'); background-position: top right; background-repeat: no-repeat;"{% endif %}>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="seal">
      {% if static %}<img src="{{ static }}/logo-email.png" alt="Geral" width="150" style="display: block; border: 0;">{% else %}<span class="seal-text display">GERAL</span>{% endif %}
    </td></tr></table>
    <p style="margin: 16px 0 0 0;"><span class="kicker">{{ e.label }}</span></p>
    <h1 class="headline display">{{ e.headline }}</h1>
    {% if e.intro %}<p class="intro" style="margin: 0;">{{ e.intro }}</p>{% endif %}
  </td></tr>
  <!--welcome-->
  {% for s in e.series %}{% set w = s.week %}
  <tr><td class="halfway">
    {% if static %}<img src="{{ static }}/meio-campo.png" alt="" width="600" height="28" style="display: block; width: 100%; max-width: 600px; height: auto; border: 0;">{% else %}<div class="chalk">&nbsp;</div>{% endif %}
  </td></tr>
  <tr><td style="padding: 0 12px;">
    <table role="presentation" class="serie" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td class="serie-name display">{{ s.name }}</td>
          <td class="serie-phase" align="right">{% if w.phase %}<span class="phase">{{ w.phase }}</span>{% endif %}</td>
        </tr></table>
      </td></tr>
      <tr><td class="serie-body">
        {% if s.summary %}<p class="summary">{{ s.summary }}</p>{% endif %}
        {% if w.results %}
        <p class="label">Resultados</p>
        {% for g in w.results %}
        <table role="presentation" class="game" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 4px;"><tr>
          <td class="team" align="right" width="42%">{{ g.home }}</td>
          <td class="score mono" align="center">{{ g.home_goals }} x {{ g.away_goals }}</td>
          <td class="team" width="42%">{{ g.away }}{% if g.home_penalties is not none %}<br><span class="pens">Pênaltis {{ g.home_penalties }} x {{ g.away_penalties }}</span>{% endif %}</td>
        </tr></table>
        {% endfor %}
        {% endif %}
        {% if w.table_top %}
        <p class="label">Tabela</p>
        <table role="presentation" class="table" width="100%" cellpadding="0" cellspacing="0" border="0">
          {% for r in w.table_top %}<tr><td width="30">{{ r.position }}º</td><td>{{ r.team }}</td><td align="right"><b>{{ r.points }}</b> pts · {{ r.played }} j</td></tr>{% endfor %}
          {% if w.table_bottom %}<tr class="gap"><td colspan="3">···</td></tr>
          {% for r in w.table_bottom %}<tr><td width="30">{{ r.position }}º</td><td>{{ r.team }}</td><td align="right"><b>{{ r.points }}</b> pts · {{ r.played }} j</td></tr>{% endfor %}{% endif %}
        </table>
        {% endif %}
        {% if s.picks %}
        <p class="label">Notícias</p>
        {% for a in s.picks %}<p class="news"><a href="{{ a.url }}">{{ a.title }}</a></p>{% endfor %}
        {% endif %}
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}
  <tr><td style="padding-top: 18px;">&nbsp;</td></tr>
  <tr><td class="foot" align="center">
    Geral · o futebol brasileiro da semana, da Série A à D. Dados e notícias: ge.{% if unsubscribe_url %}<br><a href="{{ unsubscribe_url }}">Sair da edição geral</a>{% endif %}
  </td></tr>
</table>
</td></tr></table>
</body>
</html>
